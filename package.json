{
  "name": "@jaudjoel/bun-optimize-plugin",
  "version": "0.1.0",
  "description": "A Bun build plugin that re-encodes images to WebP and audio and video to WebM.",
  "author": "Joel Lof <joel.lof@icloud.com> (https://joellof.com/)",
  "license": "MIT",
  "type": "module",
  "module": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "intent.md",
    "README.md"
  ],
  "scripts": {
    "example": "(cd example && rm -rf dist && bun build.ts && bunx serve dist)",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bun",
    "bun-plugin",
    "bundler",
    "assets",
    "webp",
    "webm",
    "opus",
    "vp9",
    "ffmpeg"
  ],
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ffmpeg-helper": "0.1.2"
  }
}
